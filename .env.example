# FluentForge environment variables
#
# Copy this file to `.env` and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API). All VITE_* values are exposed
# to the browser bundle at build time, so only use the *publishable/anon* key
# here — never the service_role key. Row Level Security protects your data.

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
